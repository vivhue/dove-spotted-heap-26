{
  "name": "bovecloset-3d-avatar-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Local 3D avatar customizer prototype for BoveCloset.",
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:server": "node --env-file=.env --experimental-strip-types server.ts",
    "dev:mobile": "npm --prefix mobile run start",
    "start": "node --env-file=.env --experimental-strip-types server.ts",
    "check": "node --env-file=.env --experimental-strip-types -e \"require('./server.ts')\" && node --check src/app.js"
  }
}
