# Copy to .env and fill in real values. .env is gitignored; never commit secrets.

# Server
PORT=8080
HOST=0.0.0.0
MAX_UPLOAD_MB=15

# OpenAI chat bot backend.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6-terra

# Cloudflare R2 (S3-compatible). The bucket stays private; the server hands out
# short-lived presigned GET URLs. Endpoint is derived from the account id:
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your_r2_bucket
PRESIGN_EXPIRES_SECONDS=604800

# Local background removal (@imgly/background-removal-node). Runs server-side in
# a worker thread. Weights ship bundled with the package, so there is no
# first-run download. The alias below maps to the library's balanced model.
BG_REMOVAL_MODEL=isnet-general-use
BG_REMOVAL_MODEL_CACHE_DIR=./data/bg-removal-cache

# IDM-VTON Gradio Space (https://huggingface.co/spaces/yisol/IDM-VTON)
IDM_VTON_SPACE=yisol/IDM-VTON

# SQLite metadata store (avatars, garments, try-on results).
APP_DB_PATH=./data/app.db
